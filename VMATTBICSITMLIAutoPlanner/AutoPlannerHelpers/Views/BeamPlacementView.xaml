<UserControl x:Class="AutoPlannerHelpers.Views.BeamPlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoPlannerHelpers.Views"
             mc:Ignorable="d">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1,0,0,0">
            <StackPanel Width="570" HorizontalAlignment="Center" Margin="5,0,5,0">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4.*"/>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition Width="2.*"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Contour overlap between VMAT isocenters:" FontSize="13" FontStyle="Normal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0"></Label>
                    <CheckBox IsChecked="{Binding ContourFieldOverlapChecked}" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <Label Grid.Column="2" Content="Added Margin (cm):" FontSize="13" FontStyle="Normal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="{Binding ContourOverlapMarginVisible}"></Label>
                    <TextBox Grid.Column="3" FontSize="12" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="35" Height="20" Margin="0,2,0,0" Text="{Binding FieldOverlapMargin}" Visibility="{Binding ContourOverlapMarginVisible}"></TextBox>
                    <Button Grid.Column="4" Content="?" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="20" Margin="0,2,0,0"></Button>
                </Grid>

                <Grid Margin="0,5,0,0" Visibility="{Binding RequestedNumberOfIsosVisible}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Requested number of VMAT isocenters: " FontSize="14" FontStyle="Normal" HorizontalAlignment="Right" VerticalAlignment="Center"></Label>
                    <TextBox Grid.Column="1" FontSize="12" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="40" Margin="0,2,0,0" Text="{Binding RequestedNumberOfVMATIsos}"></TextBox>
                    <Button Grid.Column="2" Content="Update" HorizontalAlignment="Left" VerticalAlignment="Center" Width="80" Height="20" Margin="0,2,0,0" Command="{Binding UpdateNumberOfIsocentersCommand}"></Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Linac:" Grid.Column="0" FontSize="14" FontStyle="Normal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left" HorizontalContentAlignment="Center" ItemsSource="{Binding AvailableLinacs}" SelectedItem="{Binding SelectedLinac}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Energy:" Grid.Column="0" FontSize="14" FontStyle="Normal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left" HorizontalContentAlignment="Center" ItemsSource="{Binding AvailableEnergies}" SelectedItem="{Binding SelectedEnergy}"/>
                </Grid>

                <Label Content="Proposed isocenters and beams per isocenter" FontSize="20" FontStyle="Normal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0"></Label>
                <StackPanel HorizontalAlignment="Center" Width="350" Height="Auto" Margin="5,5,0,0">
                    <ItemsControl x:Name="InitialPlanIsosSP" ItemsSource="{Binding PlanIsocenterList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Plan Id:" HorizontalAlignment="Right" FontSize="14"/>
                                        <TextBlock Text="{Binding PlanId}" Grid.Column="1" HorizontalAlignment="Left" Margin="5" FontWeight="Bold" FontSize="14" Width="100"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Isocenters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" HorizontalAlignment="Center" Content="Isocenter Id:"/>
                                                    <Label Grid.Column="1" HorizontalAlignment="Center" Content="{Binding IsocenterId}"/>
                                                    <TextBox Grid.Column="2" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="40" Height="20" Text="{Binding NumberOfBeams}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Content="Place Beams" FontWeight="Bold" Width="100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Command="{Binding CreatePlansAndPlaceBeamsCommand}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
