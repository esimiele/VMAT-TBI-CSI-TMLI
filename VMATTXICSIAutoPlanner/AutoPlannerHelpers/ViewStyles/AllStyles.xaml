<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Put dependencies FIRST (so StaticResource works) -->
        <ResourceDictionary Source="./ScrollThumbsStyle.xaml" />
        <ResourceDictionary Source="./ScrollBarStyle.xaml" />

        <!-- Now the templates that use them -->
        <ResourceDictionary Source="./ScrollViewerStyle.xaml" />

        <!-- Your tab styles -->
        <ResourceDictionary Source="./EqualTabsTop.xaml" />
        <ResourceDictionary Source="./EqualTabsLeft.xaml" />

        <!-- The rest -->
        <ResourceDictionary Source="./ButtonStyle.xaml" />
        <ResourceDictionary Source="./CheckBoxStyle.xaml" />
        <ResourceDictionary Source="./LabelStyle.xaml" />
        <ResourceDictionary Source="./TextBoxStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>