<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========== SUBTABS: Top header, equal widths ========== -->
    <!-- ========== MAIN TABS: Left header, equal heights ========== -->
    <Style x:Key="LeftEqualHeaderTabControlStyle" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Background" Value="DarkGray"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <!-- Optional: how wide your left tab strip should be -->
        <Setter Property="Tag" Value="180"/>
        <!-- treat Tag as 'TabStripWidth' -->

        <!-- Main tab header look (vertical list, no rotation) -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="MinHeight" Value="24"/>
                    <Setter Property="Background" Value="LightGray"/>
                    <!-- equal height baseline -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Border"
                                        BorderBrush="Black"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2,0,0,2"
                                        Padding="10,6"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="ContentSite"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>