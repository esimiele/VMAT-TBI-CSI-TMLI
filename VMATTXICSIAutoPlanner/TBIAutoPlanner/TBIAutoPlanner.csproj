<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net472</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWPF>true</UseWPF>
		<Deterministic>false</Deterministic>
		<LangVersion>preview</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
		<AssemblyVersion></AssemblyVersion>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>..\..\bin\VMAT-TXI-CSI</OutputPath>
		<BaseOutputPath>..\..\bin\</BaseOutputPath>
		<Build>$([System.DateTime]::op_Subtraction($([System.DateTime]::get_Now().get_Date()),$([System.DateTime]::new(2000,1,1))).get_TotalDays())</Build>
		<Revision>$([MSBuild]::Divide($([System.DateTime]::get_Now().get_TimeOfDay().get_TotalMinutes()), 2).ToString('F0'))</Revision>
		<Version>1.0.$(Build).$(Revision)</Version>
		<Configurations>Release;Debug;Debug-v15;Debug-v16</Configurations>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<Reference Include="VMS.TPS.Common.Model.API">
			<HintPath>..\..\..\VMS_TPS_resources\16.1\VMS.TPS.Common.Model.API.dll</HintPath>
		</Reference>
		<Reference Include="VMS.TPS.Common.Model.Types">
			<HintPath>..\..\..\VMS_TPS_resources\16.1\VMS.TPS.Common.Model.Types.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Debug-v16'">
		<Reference Include="VMS.TPS.Common.Model.API">
			<HintPath>..\..\..\VMS_TPS_resources\16.1\VMS.TPS.Common.Model.API.dll</HintPath>
		</Reference>
		<Reference Include="VMS.TPS.Common.Model.Types">
			<HintPath>..\..\..\VMS_TPS_resources\16.1\VMS.TPS.Common.Model.Types.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Debug-v15'">
		<Reference Include="VMS.TPS.Common.Model.API">
			<HintPath>..\..\..\VMS_TPS_resources\15.6\VMS.TPS.Common.Model.API.dll</HintPath>
		</Reference>
		<Reference Include="VMS.TPS.Common.Model.Types">
			<HintPath>..\..\..\VMS_TPS_resources\15.6\VMS.TPS.Common.Model.Types.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Prism.Core" Version="9.0.537" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\AutoPlannerHelpers\AutoPlannerHelpers.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Configuration\" />
	  <Folder Include="PlanTemplates\" />
	</ItemGroup>
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
	  <Exec Command="if NOT EXIST &quot;$(ProjectDir)$(OutDir)\templates\TBI\&quot; (&#xD;&#xA;mkdir &quot;$(ProjectDir)$(OutDir)\templates\TBI\&quot;&#xD;&#xA;)&#xD;&#xA;" />
	</Target>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="copy &quot;$(ProjectDir)Configuration\*&quot; &quot;$(ProjectDir)$(OutDir)\configuration&quot;&#xD;&#xA;copy &quot;$(ProjectDir)PlanTemplates\*&quot; &quot;$(ProjectDir)$(OutDir)\templates\TBI&quot;" />
	</Target>

</Project>
